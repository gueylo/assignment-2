{
  "expo": {
    "name": "KGPortfolio",
    "slug": "kgportfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "rw.ac.ines.reg2527953.kgportfolio",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KGPortfolio to choose a profile photo.",
          "cameraPermission": "Allow KGPortfolio to take a profile photo.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7839f099-d634-4e28-836c-04a6e73b6af8"
      }
    },
    "owner": "gueylo"
  }
}
